# link-extractor（5003）异常告警配置
#
# 权限建议：chmod 600 /etc/link-extractor-alert.env
# 修改后无需重启服务，下一轮巡检（5 分钟内）即生效。

# ══════════════════════════════════════════════════════════════════════════════
# 通道 A：飞书自建应用（推荐 —— 可发私聊，7x24）
# ══════════════════════════════════════════════════════════════════════════════
# 在 https://open.feishu.cn/app 创建企业自建应用，开通权限 im:message:send_as_bot，
# 发布版本通过后，把「凭证与基础信息」页的 App ID / App Secret 填到这里。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 接收人：用户 open_id（ou_xxx）→ 私聊；或群 chat_id（oc_xxx）→ 群。
# ⚠️ open_id 是「按应用隔离」的：换个应用，同一个人的 open_id 就变了，必须重查。
#    查法：link-extractor-alert.py --resolve-openid --email 你的邮箱@insta360.com
FEISHU_RECEIVE_ID=

# ══════════════════════════════════════════════════════════════════════════════
# 通道 B：飞书群自定义机器人（备选 —— 只能发群，做不到私聊）
# ══════════════════════════════════════════════════════════════════════════════
# 在飞书群里「设置 → 群机器人 → 添加机器人 → 自定义机器人」拿到 Webhook 地址。
# 两个通道都配时优先走 A；A 失败会自动回退到 B。
FEISHU_WEBHOOK_URL=
# 仅当创建机器人时勾选了「签名校验」才需要填，否则留空。
FEISHU_WEBHOOK_SECRET=

# ── 数据源（一般不用改）─────────────────────────────────────────────────────
ADMIN_BASE_URL=http://127.0.0.1:5003
DB_PATH=/opt/link-extractor/data/history.db

# ── 判定阈值 ─────────────────────────────────────────────────────────────────
# 成功率统计窗口（分钟）
ALERT_WINDOW_MINUTES=15
# 服务成功率低于该百分比即告警（口径已剔除用户输入问题）
ALERT_SUCCESS_RATE_THRESHOLD=90
# 窗口内有效样本少于此数则不判定成功率，避免低峰期误报
ALERT_MIN_SAMPLES=5
# P95 耗时超过该毫秒数则预警
ALERT_P95_MS=5000
# 单平台「平台暂时限制」次数达到该值即告警
ALERT_PLATFORM_LIMIT_MIN=3
# 健康检查连续失败几次才判定服务不可用
ALERT_HEALTH_FAIL_STREAK=2
# 同一故障的静默期（分钟），期间不重复推送
ALERT_REPEAT_MINUTES=30

# ── 可选 ─────────────────────────────────────────────────────────────────────
# 后台地址，填了会附在告警卡片底部
ALERT_DASHBOARD_URL=
